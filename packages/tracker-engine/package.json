{
  "name": "@nimbalyst/tracker-engine",
  "version": "0.1.0",
  "description": "Tracker sync engine, protocol, and persistence",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@nimbalyst/tracker-core": "0.1.0",
    "@nimbalyst/tracker-schema": "0.1.0",
    "@nimbalyst/collab-protocol": "0.1.0"
  }
}
